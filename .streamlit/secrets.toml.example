# Copie este arquivo para .streamlit/secrets.toml e preencha com os valores reais.
# NUNCA faça commit do secrets.toml verdadeiro.

# Chave da API do Google Gemini (Google AI Studio)
GOOGLE_API_KEY = "sua-chave-do-google-ai-studio"

# Projeto Supabase (Settings -> API)
SUPABASE_URL = "https://SEU-PROJETO.supabase.co"
SUPABASE_KEY = "sua-chave-anon-ou-publishable"

# URL pública do app (sem barra no final).
# Local: http://localhost:8501
# Streamlit Community Cloud: https://SEU-APP.streamlit.app
APP_URL = "http://localhost:8501"
